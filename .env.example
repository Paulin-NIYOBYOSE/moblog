# Copy this file to ".env" and fill in your database connection string.
#
# Local dev (Postgres on your machine):
#   DATABASE_URL="postgresql://USER@localhost:5432/moblog?schema=public"
#
# Production (Neon – free tier, recommended for Vercel):
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# ---- Authentication (single authorized user) ----
# Secret used to sign session cookies. Generate a strong one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="generate-a-long-random-string"
# The only account allowed to sign in to your journal.
AUTH_EMAIL="you@example.com"
AUTH_PASSWORD="set-a-strong-password"
