// Moblog – Prisma schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Direction {
  LONG
  SHORT
}

enum ContentStatus {
  IDEA
  DRAFT
  READY
  PUBLISHED
  ARCHIVED
}

enum Platform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  X
  LINKEDIN
  TWITCH
}

enum ContentType {
  SHORT
  LIVE_STREAM
  PHOTOS
  TEXT_STORY
  REEL
  POST
  THREAD
  VIDEO
}

// A trading account (e.g. a prop-firm challenge, live broker, demo).
model Account {
  id              String   @id @default(cuid())
  name            String
  currency        String   @default("USD")
  startingBalance Float    @default(0)
  isArchived      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // MT5 auto-sync (src/lib/mt5): the MoblogSync expert advisor posts the
  // terminal's deals with a per-account key — only its SHA-256 is stored.
  // Login/server are recorded on the first sync so a key can't later feed
  // a different MT5 account into this one.
  mt5KeyHash  String?   @unique
  mt5Login    String?
  mt5Server   String?
  mt5SyncedAt DateTime?

  trades         Trade[]
  journalEntries JournalEntry[]

  @@index([isArchived])
}

model Trade {
  id        String  @id @default(cuid())
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String

  // Dates: a trade is OPEN until it has a closeDate.
  openDate  DateTime
  closeDate DateTime?

  pair      String // e.g. "EUR/USD", "BTCUSD", "AAPL"
  direction Direction @default(LONG)
  exitLogic String? // e.g. "Full TP", "Close after confirmation", "Stop loss"

  // Results
  pnl Float  @default(0) // net P&L in account currency
  roi Float? // return on investment, percent
  rr  Float? // realized risk/reward as an R multiple (e.g. 2 = +2R)

  // Execution / analysis
  entry      Float?
  exit       Float?
  stopLoss   Float?
  takeProfit Float?
  size       Float? // position size / lots / shares
  riskAmount Float? // $ risked on the trade

  // Journaling
  setup    String? // strategy / setup tag
  comment  String?
  chartUrl String? // link to a TradingView (or other) chart

  // MT5 position ticket for trades imported by the sync — re-syncs update
  // this row instead of adding a duplicate. Null for manually logged trades.
  mt5Ticket String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, mt5Ticket])
  @@index([accountId, openDate])
  @@index([accountId, closeDate])
}

// A folder/image library for reference screenshots (e.g. FX Replay
// analytics for a given pair/year) — browsed like a computer folder tree.
// Images are stored directly in Postgres (bytea) since the app has no
// object-storage service configured; client-side compression keeps files
// small before upload.
model MediaFolder {
  id       String        @id @default(cuid())
  name     String
  parentId String?
  parent   MediaFolder?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children MediaFolder[] @relation("FolderChildren")
  images   MediaImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

model MediaImage {
  id       String       @id @default(cuid())
  folder   MediaFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  folderId String?

  name     String
  mimeType String
  size     Int // bytes, post-compression
  data     Bytes
  width    Int?
  height   Int?
  caption  String?

  createdAt DateTime @default(now())

  @@index([folderId])
}

// One row per (instrument, year) in the 168-item backtesting plan. The full
// set is seeded once (see src/lib/backtestingServer.ts) and never grows —
// `sequence` fixes the alphabetical-instrument / ascending-year order the
// daily queue walks through.
model BacktestItem {
  id          String    @id @default(cuid())
  instrument  String
  year        Int
  sequence    Int       @unique
  completed   Boolean   @default(false)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([instrument, year])
  @@index([completed])
}

// Content management for social media posts and ideas
model Content {
  id          String        @id @default(cuid())
  title       String
  status      ContentStatus @default(IDEA)
  platforms   Platform[]
  publishDate DateTime?
  type        ContentType
  url         String?
  visuals     String?
  nextStatus  String?
  notes       String?
  topics      String[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([publishDate])
  @@index([type])
}

// ---------------------------------------------------------------------------
// Journal — one reflective entry per trading day (optionally per account),
// with emotions, mistakes, plan adherence and screenshots. P&L is never
// stored here: analytics join entries to that day's closed trades so the
// numbers can't drift from the trade log.
// ---------------------------------------------------------------------------
model JournalEntry {
  id        String   @id @default(cuid())
  day       String // yyyy-mm-dd (local trading day) — string avoids TZ drift
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountId String?

  title        String?
  mood         Int? // 1 (rough) .. 5 (great), before the session
  discipline   Int? // 1 .. 5 self-rated execution
  followedPlan Boolean?

  emotionsBefore String[]
  emotionsAfter  String[]
  mistakes       String[]
  tags           String[]
  tradeIds       String[] // optional explicit links; empty = all trades that day
  checklist      String[] // DRIPDOLLAR A+ checklist items that held for the day's setup

  premarket String? // plan / bias before the session
  notes     String? // reflection
  lessons   String?

  attachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([day])
  @@index([accountId, day])
}

// Images attached to journal entries and Backtesting v2 pair-year sessions.
// Kept separate from MediaImage so they never appear in the folder gallery.
model Attachment {
  id       String  @id @default(cuid())
  name     String
  mimeType String
  size     Int
  data     Bytes
  width    Int?
  height   Int?
  caption  String?

  journalEntry   JournalEntry?   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  journalEntryId String?
  btItem         BacktestV2Item? @relation(fields: [btItemId], references: [id], onDelete: Cascade)
  btItemId       String?

  createdAt DateTime @default(now())

  @@index([journalEntryId])
  @@index([btItemId])
}

// ---------------------------------------------------------------------------
// Backtesting v2 — progress tracker for the DRIPDOLLAR backtest: 56 pair-years
// (28 instruments x 2024/2025), one per day from Nov 1 to Dec 31 2026, each
// with optional result notes/screenshots. Independent of the original
// BacktestItem plan, which it never reads or writes.
// ---------------------------------------------------------------------------
model BacktestV2Item {
  id          String    @id @default(cuid())
  instrument  String
  year        Int
  sequence    Int       @unique
  completed   Boolean   @default(false)
  completedAt DateTime?
  notes       String?

  attachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([instrument, year])
  @@index([completed])
}

// ---------------------------------------------------------------------------
// Replay — historical market replay & backtesting
// ---------------------------------------------------------------------------

// A candle source for one instrument: either automatically downloaded from a
// provider (one shared dataset per symbol+provider) or a user-imported file.
model ReplayDataset {
  id         String   @id
  symbol     String
  timeframe  String // base timeframe of the stored candles (M1 for providers)
  source     String // "fxcm" | import preset, e.g. "histdata-ascii"
  kind       String   @default("import") // "provider" | "import"
  priceBasis String
  // DatasetMeta minus derived coverage (quality report, files, timezone…)
  meta       Json
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  days   ReplayCandleDay[]
  chunks ReplayProviderChunk[]

  @@index([symbol, source])
}

// Which trading weeks have been downloaded, so a week is downloaded at most
// once and missing weeks aren't re-requested forever. Written in the same
// transaction as the candles they produced.
model ReplayProviderChunk {
  dataset   ReplayDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  datasetId String
  chunk     String // e.g. "2024-W10"
  status    String // "ok" | "partial" | "missing" | "empty" (legacy)
  n         Int
  bytes     Int      @default(0)
  // Rejected rows etc. from validating this file.
  quality   Json?
  fetchedAt DateTime @default(now())
  // Provider whose candles are stored ("fxcm" | "exness"), null when none had the week.
  source    String?
  // Providers asked for this week; one not asked yet gets a chance to fill it.
  tried     String[] @default(["fxcm"])

  @@id([datasetId, chunk])
}

// One UTC calendar day of candles, packed (int32 price points + float32
// volume + optional spread) and deflated. Days with no trading are stored as
// status "empty" so they are never downloaded twice.
model ReplayCandleDay {
  dataset   ReplayDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  datasetId String
  day       String // YYYY-MM-DD (UTC)
  status    String // "ok" | "empty"
  n         Int
  firstT    Int?
  lastT     Int?
  bytes     Int
  data      Bytes?
  rev       Int      @default(1)
  fetchedAt DateTime @default(now())

  @@id([datasetId, day])
}

model ReplaySession {
  id        String   @id
  name      String
  symbol    String
  timeframe String
  datasetId String
  status    String // "preparing" | "active" | "completed"
  favorite  Boolean  @default(false)
  archived  Boolean  @default(false)
  strategy  String   @default("")
  tags      String[]
  // Everything else of the session (settings, commands, ledger, drawings…)
  // as JSON text — exact, unlike JSONB, which can round float digits.
  data      String
  // Optimistic concurrency: bumped on every save, checked on write.
  revision  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journal ReplayJournalEntry[]

  @@index([updatedAt])
}

// Journal entry for one trade (or open position) of a session.
model ReplayJournalEntry {
  session   ReplaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  tradeId   String
  entry     Json
  updatedAt DateTime      @updatedAt

  @@id([sessionId, tradeId])
}

// Small key/value settings: strategy templates, preferences.
model ReplayMeta {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
